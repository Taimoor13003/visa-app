# Copy to .env and fill in. .env stays on this machine (it is in .gitignore) — never commit or share it.

# Portal logins: the script types these into the login form and clicks Sign in.
# CAPTCHA and OTP are still completed by a person in the browser window when the portal asks.
VFS_EMAIL=
VFS_PASSWORD=
BLS_EMAIL=
BLS_PASSWORD=

# Telegram: create a bot with @BotFather, then get chat IDs (e.g. via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=               # comma-separated: you, Syed, a group…
TELEGRAM_OPERATOR_CHAT_IDS=      # who gets "login needed" / "check failing" messages

# Email (Gmail: use an App Password, not the normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAILS=                    # comma-separated
OPERATOR_EMAILS=

# Demo portal (python app.py --demo): the login the monitor types into the local stand-in portal
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo1234

# Proxy for running outside Pakistan (cloud server). Leave empty on a laptop in Pakistan.
# A Pakistan residential proxy is required for BLS — it blocks foreign IPs and datacenter/VPN ranges.
PROXY_SERVER=                     # e.g. http://pk.proxyprovider.com:8000  or socks5://host:port
PROXY_USERNAME=
PROXY_PASSWORD=

# Browser engine: leave empty for plain Playwright Chromium, or "cloak" for CloakBrowser
# (stealth Chromium — hides automation fingerprints for Cloudflare/bot checks; does not change the IP).
# pip install cloakbrowser, then claim the free key at https://cloakbrowser.dev (or run: cloakbrowser login)
BROWSER_ENGINE=
CLOAKBROWSER_LICENSE_KEY=
