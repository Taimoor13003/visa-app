# Copy to .env and fill in. .env stays on this machine (it is in .gitignore) — never commit or share it.

# Portal logins: the script types these into the login form and clicks Sign in.
# CAPTCHA and OTP are completed by a person in the browser window when the portal asks
# (VFS routes with auto_login read the emailed code themselves, see OTP_IMAP_PASSWORD below).
VFS_EMAIL=
VFS_PASSWORD=
BLS_EMAIL=
BLS_PASSWORD=
BLS_IDN_EMAIL=                   # BLS Indonesia → Spain (indonesia.blsspainglobal.com)
BLS_IDN_PASSWORD=

# Telegram: create a bot with @BotFather, then get chat IDs (e.g. via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=               # comma-separated: you, Syed, a group…
TELEGRAM_OPERATOR_CHAT_IDS=      # who gets "login needed" / "check failing" messages

# Email (Gmail: use an App Password, not the normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=                   # may stay empty when SMTP_USER is the same mailbox as OTP_IMAP_USER below
# Port 465 connects with TLS at once (e.g. smtp.hostinger.com); 587 upgrades with STARTTLS (e.g. smtp.gmail.com).
# A route with report_every_check: true mails ALERT_EMAILS the result of every check, slot or no slot.
ALERT_EMAILS=                    # comma-separated
OPERATOR_EMAILS=

# Demo portal (python app.py --demo): the login the monitor types into the local stand-in portal
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo1234

# Proxy for running outside Pakistan (cloud server). Leave empty on a laptop in Pakistan.
# A Pakistan residential proxy is required for BLS — it blocks foreign IPs and datacenter/VPN ranges.
PROXY_SERVER=                     # e.g. http://pk.proxyprovider.com:8000  or socks5://host:port
PROXY_USERNAME=
PROXY_PASSWORD=

# VFS only: attach to a Chrome window that YOU started and logged in to (README, "VFS: attach to your
# own Chrome"). VFS withholds its login form from browsers started by the script, and its login lives
# in one tab, so the script works inside your open tab and never reloads it. Local addresses only.
# BROWSER_CDP_URL=http://127.0.0.1:9222
BROWSER_CDP_URL=

# VFS automatic login, for routes with `auto_login: true` in config.yaml (README, "VFS: automatic login").
# The portal emails a one-time code after Sign In; the monitor reads it from this mailbox over IMAP,
# read-only, and only looks at mail from the portal's sender. Gmail: turn on 2-Step Verification,
# create an App Password (Google Account → Security → App passwords) and paste it here.
# Never put the normal mailbox password here. Check the setup with: python otp_mail.py --check
OTP_IMAP_PASSWORD=
OTP_IMAP_USER=                    # the mailbox address; empty = the route's <PREFIX>_EMAIL
OTP_IMAP_HOST=imap.gmail.com
# Another provider: its IMAP server and the normal mailbox password, e.g. imap.hostinger.com.
# When the portal login is an alias, OTP_IMAP_USER is the mailbox the alias delivers to.
OTP_MAIL_FROM=vfs                 # part of the sender address of the code mail

# Browser channel: leave empty for Playwright's bundled Chromium, or "chrome" / "msedge" to drive the
# browser installed on this machine. This did NOT get past VFS (tested 2026-11-19); use BROWSER_CDP_URL there.
BROWSER_CHANNEL=

# Browser engine: leave empty for plain Playwright Chromium, or "cloak" for CloakBrowser
# (stealth Chromium — hides automation fingerprints for Cloudflare/bot checks; does not change the IP).
# pip install cloakbrowser, then claim the free key at https://cloakbrowser.dev (or run: cloakbrowser login)
BROWSER_ENGINE=
CLOAKBROWSER_LICENSE_KEY=
